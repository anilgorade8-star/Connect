# Backend Server URL (Defaults automatically to deployed Render URL in production)
VITE_SERVER_URL=https://connect-1-6be8.onrender.com

# Optional Custom TURN Server Configuration (e.g., from Metered.ca, Twilio, or Coturn)
# If omitted, reliable Open Relay Project community TURN servers are automatically used as fallback.
# VITE_TURN_URLS=turn:relay.metered.ca:80,turn:relay.metered.ca:443,turn:relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=openrelayproject
# VITE_TURN_CREDENTIAL=openrelayproject